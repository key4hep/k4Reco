<!-- An empty world that only provides the tracker cellID encoding (the one of MAIA_v0),
     for tests that need the GeoSvc but not the detector: loading MAIA takes ~25 s. -->
<lccdd>
  <info name="BIBUtilsTestGeometry" title="Empty world with the tracker cellID encoding" status="test" version="v0"/>
  <define>
    <constant name="world_size" value="1*m"/>
    <constant name="world_x" value="world_size"/>
    <constant name="world_y" value="world_size"/>
    <constant name="world_z" value="world_size"/>
    <constant name="tracker_region_rmax" value="1*m"/>
    <constant name="tracker_region_zmax" value="1*m"/>
    <constant name="GlobalTrackerReadoutID" type="string" value="system:5,side:-2,layer:6,module:11,sensor:8"/>
  </define>
  <materials>
    <element Z="1" formula="H" name="H">
      <atom type="A" unit="g/mol" value="1.00794"/>
    </element>
    <material name="Vacuum">
      <D type="density" unit="g/cm3" value="1e-25"/>
      <fraction n="1" ref="H"/>
    </material>
    <material name="Air">
      <D type="density" unit="g/cm3" value="1e-25"/>
      <fraction n="1" ref="H"/>
    </material>
  </materials>
</lccdd>
